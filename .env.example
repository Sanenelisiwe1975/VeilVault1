# VeilVault1 Environment Configuration
# Copy this file to .env and fill in your values.

#  General 
NODE_ENV=development
PORT=3000

# Stellar / Soroban 
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

#  Contract IDs (populated by deploy scripts)
VAULT_CONTRACT_ID=CA5UAF7NF2GJMAJPPZMUYSQIDSAR7V53CYGNHULQS3UCHWKD5LW7KXQW
X402_VERIFIER_CONTRACT_ID=CATRAJKXFDKULWQ2V47LFOBEQFXUPKAF7S73UNMZ4H2YTLIZEKEIBK5N
DWALLET_VERIFIER_CONTRACT_ID=CDO5BCWNNRK3BOKKLEUKSK4B4PA656725UFNCBA5SJCXO75GNFPIZQGG
AGENT_REGISTRY_CONTRACT_ID=CBND24UI7RBAYCXLZM5RH42EVXQLBG6XR3Y4ONA673YBTQQEBPZ6S2TA
STRATEGY_MARKETPLACE_CONTRACT_ID=CB25FJV362DOLINALRMLOQMJEMDV3UF4D3ZIVTBUBKEQWZWWZONDAKPW
STOKVEL_REGISTRY_CONTRACT_ID=CAFXKDFFS2LFGG2V3EMYOMXPOB5HZWF367CY42Z4WWKA2ZQPKM7TPODM
ZK_VERIFIER_CONTRACT_ID=CBLYCZWDBYB6JQ4BAZSPUTCR77423VXE4QZOI5ZVZO6XQQ5YEVNPOR7A
PRIVACY_POOL_CONTRACT_ID=CAE3XBP6E5DFLAEZXJNYQ2HMJWKRIXP44U2EE6E5VRGLLGCLS4PO24ZI
PASSKEY_REGISTRY_CONTRACT_ID=https://veilvault1.onrender.com

# ZK circuit ID registered in the zk-attestation contract (32-byte hex).
# Generated by: cd prover && cargo run -- setup && cargo run -- format-vk --circuit-id <ID> ...
# Then run: stellar contract invoke --id $ZK_VERIFIER_CONTRACT_ID ... -- register_circuit ...
# And:      stellar contract invoke --id $PRIVACY_POOL_CONTRACT_ID ... -- set_verifier ...
WITHDRAW_CIRCUIT_ID=0101010101010101010101010101010101010101010101010101010101010101

#  Admin keypair (Stellar)
# Generate with: stellar keys generate --no-fund admin && stellar keys show --secret-key admin
ADMIN_SECRET_KEY=SABG4FBRGFI75FAZVR7VVPBV4LAWHXUJHNUGX2VPOZLRQ4QW3P7EYISF

#  SEP-10 Web Authentication
# Dedicated signing key for SEP-10 challenges; falls back to ADMIN_SECRET_KEY if unset.
SEP10_SIGNING_SECRET_KEY=
WEB_AUTH_DOMAIN=veilvault1.onrender.com
HOME_DOMAIN=veil-vault1.vercel.app

#  Passkey sign-in (account abstraction)
# RP ID must be a bare domain (no scheme/port) that exactly matches where the
# frontend is served; "localhost" is correct for local dev.
WEBAUTHN_RP_NAME=VeilVault1
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
# Hex-encoded hash of the uploaded smart-wallet WASM. Leave empty to upload
# (and cache) it automatically on first passkey registration.
SMART_WALLET_WASM_HASH=

# Oracle keypair (for x402 payment attestation)
ORACLE_SECRET_KEY=SDFYEOGDLZ6WCEYGJ6CWRICE4MPOXV3OC4RC4AK65WTJNEZHNPPATQMC

# Ika dWallet API 
IKA_API_URL=https://api.testnet.ika.xyz
IKA_API_KEY=your-ika-api-key
IKA_NETWORK=testnet

#  FHE Configuration 
FHE_KEY_SIZE=128
FHE_KEYS_DIR=./fhe-keys

#  Security 
# Generate with: openssl rand -hex 32
JWT_SECRET=ad779c1ec31cb600daefc24fd19eb91ea4393c2bc71653843942c5a9aef19a01
# SHA-256 hash of your API key (leave empty to disable API key auth in dev)
API_KEY_HASH=0cc9d086b4c01fb34b65f44f39be23b3ef0bce81d1ca1563aae63d7beab39c3e

#  Logging 
LOG_LEVEL=info

#  CORS 
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
