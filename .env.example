# VeilVault1 Environment Configuration
# Copy this file to .env and fill in your values.

#  General 
NODE_ENV=development
PORT=3000

# Stellar / Soroban 
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

#  Contract IDs (populated by deploy scripts)
VAULT_CONTRACT_ID=
X402_VERIFIER_CONTRACT_ID=
DWALLET_VERIFIER_CONTRACT_ID=
AGENT_REGISTRY_CONTRACT_ID=
STRATEGY_MARKETPLACE_CONTRACT_ID=
STOKVEL_REGISTRY_CONTRACT_ID=
ZK_VERIFIER_CONTRACT_ID=
PRIVACY_POOL_CONTRACT_ID=
PASSKEY_REGISTRY_CONTRACT_ID=

# ZK circuit ID registered in the zk-attestation contract (32-byte hex).
# Generated by: cd prover && cargo run -- setup && cargo run -- format-vk --circuit-id <ID> ...
# Then run: stellar contract invoke --id $ZK_VERIFIER_CONTRACT_ID ... -- register_circuit ...
# And:      stellar contract invoke --id $PRIVACY_POOL_CONTRACT_ID ... -- set_verifier ...
WITHDRAW_CIRCUIT_ID=

#  Admin keypair (Stellar)
# Generate with: stellar keys generate --no-fund admin && stellar keys show --secret-key admin
ADMIN_SECRET_KEY=

#  SEP-10 Web Authentication
# Dedicated signing key for SEP-10 challenges; falls back to ADMIN_SECRET_KEY if unset.
SEP10_SIGNING_SECRET_KEY=
WEB_AUTH_DOMAIN=veilvault1.onrender.com
HOME_DOMAIN=veil-vault1.vercel.app

#  Passkey sign-in (account abstraction)
# RP ID must be a bare domain (no scheme/port) that exactly matches where the
# frontend is served; "localhost" is correct for local dev.
WEBAUTHN_RP_NAME=VeilVault1
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
# Hex-encoded hash of the uploaded smart-wallet WASM. Leave empty to upload
# (and cache) it automatically on first passkey registration.
SMART_WALLET_WASM_HASH=

# Oracle keypair (for x402 payment attestation)
ORACLE_SECRET_KEY=

# Ika dWallet API 
IKA_API_URL=https://api.testnet.ika.xyz
IKA_API_KEY=your-ika-api-key
IKA_NETWORK=testnet

#  FHE Configuration 
FHE_KEY_SIZE=128
FHE_KEYS_DIR=./fhe-keys

#  Security 
# Generate with: openssl rand -hex 32
JWT_SECRET=
# SHA-256 hash of your API key (leave empty to disable API key auth in dev)
API_KEY_HASH=

#  Logging 
LOG_LEVEL=info

#  CORS 
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
